# Token dari @BotFather
BOT_TOKEN=
# ID Telegram admin, pisahkan koma jika lebih dari satu. Contoh: 123456789,987654321
ADMIN_IDS=
# Kunci rahasia webhook (huruf, angka, _ atau - saja)
WEBHOOK_SECRET=
# Kunci untuk membuka halaman /api/setup
SETUP_KEY=
# Kunci untuk cron (dipakai Vercel Cron dan cron eksternal)
CRON_SECRET=
# Supabase: Project URL dan service_role key
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Opsional
TIMEZONE=Asia/Jakarta
# Opsional: chat tujuan untuk pengecekan postingan terhapus (default: admin pertama)
LOG_CHAT_ID=
# Opsional: 'before' (bawaan) kirim pesan persetujuan sebelum approve, 'after' sesudah approve
DM_ORDER=before
# Opsional: batas waktu (menit) calon member menyelesaikan persetujuan aturan / wajib join. Bawaan 1440 (24 jam)
GATE_TTL_MINUTES=1440
